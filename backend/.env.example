# =====================================================================
# Sabor do Oeste – Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =====================================================================

# ----- Server -----
PORT=3001
NODE_ENV=development

# Allowed frontend origins (comma-separated)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# ----- Firebase Admin SDK -----
# Path to your Firebase service account JSON key file.
# Download from Firebase Console → Project Settings → Service Accounts.
# Alternatively set FIREBASE_SERVICE_ACCOUNT_JSON with the full JSON content.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

FIREBASE_PROJECT_ID=YOUR_PROJECT_ID

# ----- AI Provider -----
# Supported values: "openai" | "gemini"
# If the primary provider fails, the other is used as fallback.
AI_PROVIDER=openai
AI_FALLBACK_PROVIDER=gemini

# ----- OpenAI -----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ----- Google Gemini -----
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-flash

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
