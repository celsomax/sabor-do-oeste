# Servidor
PORT=8787
NODE_ENV=development
# Separe multiplas origens com virgula
FRONTEND_ORIGIN=http://127.0.0.1:5500,https://seu-app.vercel.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120

# Firebase (escolha UMA opcao)
# 1) Colar JSON inteiro da service account em linha unica:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# 2) Ou apontar para arquivo JSON local (caminho absoluto):
# FIREBASE_SERVICE_ACCOUNT_PATH=/Users/voce/keys/firebase-service-account.json
FIREBASE_PROJECT_ID=

# IA: ordem de fallback (ex: openai,gemini ou gemini,openai)
# IMPORTANTE: Você PRECISA de PELO MENOS UM dos dois provedores configurados
# Se ambos estiverem configurados, tenta OpenAI primeiro; se falhar, tenta Gemini (redundância)
# Se apenas um estiver configurado, usa apenas aquele
AI_PROVIDER_PRIORITY=openai,gemini

# OpenAI - OPCIONAL se você tiver GEMINI_API_KEY
# Crie conta em: https://platform.openai.com/api/keys
# Requer pagamento por uso (não há free tier para API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini - OPCIONAL se você tiver OPENAI_API_KEY
# Crie conta em: https://makersuite.google.com/app/apikey
# Tem free tier limitado (1500 requisições/minuto) - verifique quotas em https://console.cloud.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro
